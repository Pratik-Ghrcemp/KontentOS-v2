# ==============================================================================
# KontentOS / Studio Hub — Environment Configuration Template
# Copy this file to .env.local and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE INFRASTRUCTURE (Required for Real Multi-User Production)
# ------------------------------------------------------------------------------
# Safe for client-side exposure
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Set to 'true' to force offline demo mode without database
NEXT_PUBLIC_DEMO_MODE=false

# ------------------------------------------------------------------------------
# 2. AI SERVICES (Optional - Falls back to built-in templates if omitted)
# ------------------------------------------------------------------------------
# Server-only secret key
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=openai

# Optional: Microsoft Azure OpenAI Configuration
# AZURE_OPENAI_API_KEY=your-azure-api-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# ------------------------------------------------------------------------------
# 3. VIDEO RENDERING INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Server-only: Local FFmpeg executable path (auto-detects @ffmpeg-installer if omitted)
# LOCAL_FFMPEG_PATH=/usr/bin/ffmpeg

# Server-only: Directory where rendered MP4 files are temporarily stored
# LOCAL_RENDER_OUTPUT_DIR=/tmp/kontentos-renders

# Optional: Remote Distributed Render Worker URL (if using microservice worker)
# EXTERNAL_RENDER_WORKER_URL=https://render-worker.yourdomain.com
# EXTERNAL_RENDER_WORKER_TOKEN=your-worker-auth-token
